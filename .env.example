# Copy to .env (or run `pnpm setup:env` to generate fresh dev secrets).
DATABASE_URL=postgresql://agenttrust@localhost:54329/agenttrust
TEST_DATABASE_URL=postgresql://agenttrust@localhost:54329/agenttrust_test
PORT=4000

# Platform signing key (Ed25519 PKCS#8 PEM, base64-encoded). Signs authorizations
# and audit events. Production: replace LocalEd25519Signer with a KMS-backed signer.
AGENTTRUST_SIGNING_KEY_ID=
AGENTTRUST_SIGNING_KEY_PEM_B64=

# Secret used to HMAC bank details into fingerprints (>= 32 chars).
AGENTTRUST_PAYEE_PEPPER=

# Platform-operator token required to create organizations.
AGENTTRUST_BOOTSTRAP_TOKEN=

# Development-only human login (replaces a real OIDC provider locally).
# Refused when NODE_ENV=production.
AGENTTRUST_DEV_AUTH=true
AGENTTRUST_DEV_AUTH_SECRET=

# HMAC secret for sandbox payment-provider webhooks (>= 32 chars).
AGENTTRUST_SANDBOX_WEBHOOK_SECRET=
