generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// All money columns are BigInt minor units (cents). Never floating point.
// Every tenant-owned row carries organizationId; every query is scoped by it.

enum OrgStatus {
  active
  suspended
}

enum VerificationStatus {
  unverified
  pending
  verified
}

enum UserRole {
  admin
  approver
  member
}

enum UserStatus {
  active
  disabled
}

enum AgentStatus {
  active
  suspended
  revoked
}

enum CredentialStatus {
  active
  revoked
}

enum PolicyStatus {
  active
  superseded
}

enum SupplierStatus {
  active
  blocked
}

enum PoStatus {
  open
  closed
  cancelled
}

enum InvoiceStatus {
  open
  /// A payment for this invoice is in flight (requested/accepted/processing/unknown).
  processing
  /// Paid only once the payment SETTLED (provider acceptance is not finality).
  paid
  void
  /// A payment for this invoice failed after acceptance, was returned or reversed.
  /// Not payable again until reconciled and explicitly released by an administrator.
  payment_exception
}

enum Decision {
  ALLOW
  REVIEW
  DENY
}

enum AuthorizationStatus {
  allowed
  pending_review
  denied
  rejected
  consumed
  expired
  /// Underlying record changed (supplier, delegation, policy) before execution.
  invalidated
}

enum ApprovalDecision {
  approved
  rejected
}

enum ReservationStatus {
  active
  consumed
  released
}

/// Payment lifecycle. Provider ACCEPTANCE is not finality; only SETTLED is.
///   requested -> accepted -> processing -> settled -> (returned | reversed)
///   requested | accepted | processing -> failed
///   requested -> unknown -> (reconcile) -> any observed provider state | reconciliation_required
/// A timeout is never treated as failure.
enum TransactionStatus {
  requested
  accepted
  processing
  settled
  failed
  returned
  reversed
  unknown
  reconciliation_required
}

enum ActorType {
  agent
  user
  system
  integration
}

enum FulfillmentType {
  physical_goods
  services
  subscription
  digital_goods
}

enum InstructionSource {
  human
  erp
}

/// Only `approved` instructions can authorize payments. A successful ERP sync
/// does NOT imply approval.
enum InstructionStatus {
  pending_approval
  approved
  rejected
  revoked
}

enum ReceiptType {
  goods_received
  service_completed
  subscription_activated
  digital_delivered
}

/// Distinct assurance levels for a supplier's payment destination (ordered).
///  recorded           bank details entered (by one person)
///  reviewed           a second person reviewed them with out-of-band evidence
///  account_verified   an account-verification provider confirmed the account exists and is open
///  ownership_verified the provider confirmed the account holder matches the supplier's legal entity
enum SupplierAssurance {
  recorded
  reviewed
  account_verified
  ownership_verified
}

enum IntegrationStatus {
  active
  revoked
}

model Organization {
  id                 String             @id
  name               String
  status             OrgStatus          @default(active)
  verificationStatus VerificationStatus @default(unverified)
  createdAt          DateTime           @default(now())
  updatedAt          DateTime           @updatedAt
}

model User {
  id                     String     @id
  organizationId         String
  /// Subject from the identity provider (OIDC `sub`). Never user-supplied at login.
  externalIdentityId     String     @unique
  email                  String
  role                   UserRole
  status                 UserStatus @default(active)
  /// Max per-transaction authority this person holds and may delegate / approve.
  spendingAuthorityCents BigInt     @default(0)
  createdAt              DateTime   @default(now())

  @@unique([organizationId, email])
  @@index([organizationId])
}

model Agent {
  id             String      @id
  organizationId String
  ownerUserId    String
  name           String
  description    String?
  status         AgentStatus @default(active)
  statusReason   String?
  createdAt      DateTime    @default(now())
  updatedAt      DateTime    @updatedAt

  @@index([organizationId])
}

/// Long-lived WORKLOAD credential (public key only). It can do exactly one
/// thing: mint short-lived session credentials. It cannot request
/// authorizations or execute payments. Production: replaced/augmented by a
/// workload-identity attestation (SPIFFE JWT-SVID, cloud OIDC) and the private
/// key lives in a sidecar/KMS outside the LLM-accessible environment.
model AgentCredential {
  id             String           @id
  agentId        String
  organizationId String
  publicKeyPem   String
  status         CredentialStatus @default(active)
  createdAt      DateTime         @default(now())
  expiresAt      DateTime?
  revokedAt      DateTime?
  /// Set when repeated authentication failures suggest probing or compromise (alert, not suspension).
  flaggedAt      DateTime?
  flagReason     String?

  @@index([agentId])
}

/// Short-lived session credential (default 15 min) minted by a workload credential.
/// Only sessions may request authorizations and execute payments.
model AgentSession {
  id             String    @id
  organizationId String
  agentId        String
  credentialId   String
  publicKeyPem   String
  expiresAt      DateTime
  revokedAt      DateTime?
  createdAt      DateTime  @default(now())

  @@index([agentId])
}

/// Replay protection for signed agent requests. `credentialId` holds the signing key id (akc_ or ags_).
model AgentRequestNonce {
  credentialId String
  nonce        String
  createdAt    DateTime @default(now())

  @@id([credentialId, nonce])
  @@index([createdAt])
}

/// Low-confidence security signals (e.g. unauthenticated signature failures).
/// Kept out of the audit chain so outsiders cannot flood evidence storage.
model SecuritySignal {
  id             String   @id
  organizationId String
  agentId        String
  keyId          String
  kind           String
  reason         String
  createdAt      DateTime @default(now())

  @@index([organizationId, agentId, kind, createdAt])
}

model Delegation {
  id                  String    @id
  organizationId      String
  agentId             String
  grantedByUserId     String
  actions             String[]
  maxTransactionCents BigInt
  monthlyLimitCents   BigInt
  currency            String
  /// When false, any approved supplier of the organization is allowed.
  restrictSuppliers   Boolean   @default(false)
  approvedSupplierIds String[]
  validFrom           DateTime
  expiresAt           DateTime
  revokedAt           DateTime?
  revokedByUserId     String?
  createdAt           DateTime  @default(now())

  @@index([organizationId, agentId, createdAt])
}

/// Policies are immutable versions; an update creates a new version.
model Policy {
  id              String       @id
  organizationId  String
  name            String
  version         Int
  rules           Json
  status          PolicyStatus
  createdByUserId String?
  createdAt       DateTime     @default(now())

  @@unique([organizationId, version])
  @@index([organizationId, status])
}

model Supplier {
  id                                String             @id
  organizationId                    String
  name                              String
  externalReference                 String?
  verificationStatus                VerificationStatus
  /// HMAC fingerprint of the verified bank details. Raw account numbers are not stored.
  paymentDestinationFingerprint     String?
  paymentDestinationType            String?
  paymentDestinationLast4           String?
  /// Counterparty id at the payment provider; the gateway pays this, never agent-supplied details.
  paymentCounterpartyRef            String?
  paymentDestinationChangedByUserId String?
  paymentDestinationChangedAt       DateTime?
  verifiedByUserId                  String?
  verifiedAt                        DateTime?
  /// How the payment destination was confirmed to belong to this supplier (e.g. callback to a known number).
  verificationEvidence              String?
  /// Registered legal name, used for account-ownership matching.
  legalName                         String?
  assuranceLevel                    SupplierAssurance  @default(recorded)
  /// Incremented on every change; authorizations bind to the version they were issued against.
  version                           Int                @default(1)
  status                            SupplierStatus     @default(active)
  createdAt                         DateTime           @default(now())
  updatedAt                         DateTime           @updatedAt

  @@index([organizationId])
}

/// Immutable history of supplier records (one row per version).
model SupplierVersion {
  id              String   @id
  organizationId  String
  supplierId      String
  version         Int
  changeType      String
  changedByUserId String
  snapshot        Json
  createdAt       DateTime @default(now())

  @@unique([supplierId, version])
}

model PurchaseOrder {
  id                  String   @id
  organizationId      String
  supplierId          String
  externalReference   String
  approvedAmountCents BigInt
  currency            String
  status              PoStatus @default(open)
  approvedByUserId    String
  createdAt           DateTime @default(now())

  @@unique([organizationId, externalReference])
  @@index([organizationId, supplierId])
}

model Invoice {
  id                  String        @id
  organizationId      String
  supplierId          String
  purchaseOrderId     String?
  invoiceNumber       String
  amountCents         BigInt
  currency            String
  documentHash        String?
  status              InvoiceStatus @default(open)
  paidAt              DateTime?
  paidByTransactionId String?
  /// Purchase instruction this invoice bills against (optional).
  instructionId       String?
  createdByUserId     String?
  createdByIntegrationId String?
  createdAt           DateTime      @default(now())
  lines               InvoiceLine[]

  /// The same supplier invoice number can only exist once per organization.
  @@unique([organizationId, supplierId, invoiceNumber])
  @@index([organizationId])
}

model Authorization {
  id                            String              @id
  organizationId                String
  agentId                       String
  credentialId                  String
  /// Session credential that signed the request.
  sessionId                     String?
  delegationId                  String?
  policyId                      String?
  policyVersion                 Int?
  idempotencyKey                String
  /// Hash of the agent's request (used for idempotency).
  transactionFingerprint        String
  /// Hash of the COMPLETE payment instruction this authorization permits:
  /// request fields + payment rail + provider destination + supplier-record
  /// version + policy version + delegation. Signed into the token.
  authorizationFingerprint      String?
  // Snapshot of the exact transaction intent (immutable once created).
  action                        String
  supplierId                    String?
  supplierVersion               Int?
  paymentRail                   String?
  destinationRef                String?
  paymentDestinationFingerprint String
  amountCents                   BigInt
  currency                      String
  purchaseOrderId               String?
  invoiceId                     String?
  /// Purchase instruction (exact version) and the exact lines being paid.
  instructionId                 String?
  instructionVersion            Int?
  /// [{ instructionLineNumber, sku, quantityMilli, unitPriceCents, lineTotalCents }]
  lines                         Json?
  linesHash                     String?
  // Outcome
  initialDecision               Decision
  decision                      Decision
  status                        AuthorizationStatus
  reasonCodes                   String[]
  checks                        Json
  approvable                    Boolean             @default(false)
  token                         String?
  tokenNonce                    String?
  expiresAt                     DateTime
  consumedAt                    DateTime?
  invalidatedReason             String?
  createdAt                     DateTime            @default(now())
  updatedAt                     DateTime            @updatedAt

  @@unique([agentId, idempotencyKey])
  @@index([organizationId, createdAt])
  @@index([organizationId, status])
  @@index([supplierId, status])
  @@index([instructionId, status])
}

model Approval {
  id                     String           @id
  organizationId         String
  authorizationId        String           @unique
  approverUserId         String
  decision               ApprovalDecision
  transactionFingerprint String
  policyVersion          Int?
  comment                String?
  createdAt              DateTime         @default(now())
}

/// Holds budget / PO capacity / invoice while an authorization is live.
model BudgetReservation {
  id              String            @id
  organizationId  String
  authorizationId String            @unique
  agentId         String
  delegationId    String
  purchaseOrderId String?
  invoiceId       String?
  /// Purchase-instruction usage held by this reservation (uses, amount, per-line quantities).
  instructionId   String?
  /// [{ instructionLineNumber, quantityMilli }]
  lines           Json?
  amountCents     BigInt
  currency        String
  status          ReservationStatus
  expiresAt       DateTime
  createdAt       DateTime          @default(now())
  updatedAt       DateTime          @updatedAt

  @@index([agentId, status, createdAt])
  @@index([purchaseOrderId, status])
  @@index([invoiceId, status])
  @@index([instructionId, status])
}

model Transaction {
  id                     String            @id
  organizationId         String
  /// Unique: an authorization can be executed at most once.
  authorizationId        String            @unique
  agentId                String
  supplierId             String?
  invoiceId              String?
  amountCents            BigInt
  currency               String
  status                 TransactionStatus
  provider               String
  /// Sent with every provider call; the provider must deduplicate on it.
  providerIdempotencyKey String            @unique
  providerReference      String?
  failureReason          String?
  attempts               Int               @default(0)
  lastAttemptAt          DateTime?
  acceptedAt             DateTime?
  settledAt              DateTime?
  /// Set when an administrator resolves a failed/returned/reversed payment.
  resolution             String?
  resolvedAt             DateTime?
  resolvedByUserId       String?
  /// Short lease so only one worker reconciles a transaction at a time.
  leaseUntil             DateTime?
  finalizedAt            DateTime?
  createdAt              DateTime          @default(now())
  updatedAt              DateTime          @updatedAt

  @@index([organizationId, createdAt])
  @@index([status, lastAttemptAt])
}

/// Every interaction with the payment provider, for investigation and reconciliation.
model TransactionAttempt {
  id                String   @id
  organizationId    String
  transactionId     String
  attempt           Int
  /// execute | status_query
  action            String
  /// succeeded | failed | unknown | not_found | pending | crashed
  outcome           String
  providerReference String?
  detail            String?
  createdAt         DateTime @default(now())

  @@index([transactionId])
}

/// SANDBOX ONLY: simulates the external payment provider's own ledger, which
/// survives gateway crashes (as a real provider's would).
model SandboxProviderPayment {
  idempotencyKey    String   @id
  counterpartyRef   String
  amountCents       BigInt
  currency          String
  status            String
  providerReference String
  createdAt         DateTime @default(now())
}

/// SANDBOX ONLY: queued fault injections (FIFO) for testing failure handling.
model SandboxFault {
  id        String   @id
  fault     String
  createdAt DateTime @default(now())
}

/// Append-only (enforced by a database trigger, see migration).
model AuditEvent {
  id                String    @id
  organizationId    String
  sequence          Int
  actorType         ActorType
  actorId           String
  eventType         String
  subjectId         String?
  payload           Json
  payloadHash       String
  previousEventHash String?
  eventHash         String
  signature         String
  keyId             String
  createdAt         DateTime

  @@unique([organizationId, sequence])
  @@index([organizationId, eventType, createdAt])
  @@index([organizationId, actorId, createdAt])
}

model AuditChainHead {
  organizationId String  @id
  lastSequence   Int     @default(0)
  lastEventHash  String?
}

/// Privileged machine identity for a trusted ERP integration. Narrowly scoped:
/// instructions:sync, instructions:attest_approval, receipts:confirm, invoices:write.
model Integration {
  id              String            @id
  organizationId  String
  name            String
  sourceSystem    String
  scopes          String[]
  /// SHA-256 of a 256-bit random secret (shown once at creation).
  secretHash      String
  status          IntegrationStatus @default(active)
  createdByUserId String
  createdAt       DateTime          @default(now())
  revokedAt       DateTime?

  @@unique([organizationId, sourceSystem])
}

/// An independently approved business instruction: WHAT may be bought, from
/// WHOM, by WHICH agent, for HOW MUCH, how many times, until WHEN. Created by
/// humans or synced from an ERP; never by agents. Material changes bump
/// `version`, require re-approval and invalidate outstanding authorizations.
model PurchaseInstruction {
  id                String            @id
  organizationId    String
  version           Int               @default(1)
  source            InstructionSource
  sourceSystem      String?
  externalId        String?
  externalVersion   String?
  externalUpdatedAt DateTime?
  syncedAt          DateTime?
  integrationId     String?
  erpApprovalStatus String?
  erpApprovedBy     String?
  erpApprovedAt     DateTime?
  agentId           String
  supplierId        String
  purchaseOrderId   String?
  fulfillmentType   FulfillmentType
  currency          String
  maxAmountCents    BigInt
  maxUses           Int
  validFrom         DateTime
  expiresAt         DateTime
  description       String?
  materialHash      String
  linesHash         String
  status            InstructionStatus
  createdByUserId   String?
  approvedByUserId  String?
  approvedAt        DateTime?
  /// agenttrust_user | erp_attested
  approvalSource    String?
  revokedAt         DateTime?
  revokedBy         String?
  revokeReason      String?
  createdAt         DateTime          @default(now())
  updatedAt         DateTime          @updatedAt
  lines             PurchaseInstructionLine[]

  @@unique([organizationId, sourceSystem, externalId])
  @@index([organizationId, agentId, status])
}

model PurchaseInstructionLine {
  id             String  @id
  instructionId  String
  instruction    PurchaseInstruction @relation(fields: [instructionId], references: [id], onDelete: Restrict)
  lineNumber     Int
  sku            String?
  description    String
  unit           String?
  /// Quantity in thousandths (exact; 2.5 units = 2500).
  quantityMilli  BigInt
  unitPriceCents BigInt
  lineTotalCents BigInt

  @@unique([instructionId, lineNumber])
}

/// Immutable history of purchase instructions (one row per version/approval event).
model PurchaseInstructionVersion {
  id            String   @id
  organizationId String
  instructionId String
  version       Int
  changeType    String
  changedBy     String
  snapshot      Json
  createdAt     DateTime @default(now())

  @@index([instructionId, version])
}

/// Goods-received / service-completion / activation confirmation for three-way matching.
/// Recorded only by authorized humans or trusted ERP integrations.
model Receipt {
  id                String      @id
  organizationId    String
  instructionId     String
  type              ReceiptType
  /// [{ instructionLineNumber, quantityMilli }]
  lines             Json
  confirmedByUserId String?
  integrationId     String?
  externalId        String?
  note              String?
  voidedAt          DateTime?
  voidedByUserId    String?
  createdAt         DateTime    @default(now())

  @@index([instructionId])
}

model InvoiceLine {
  id                    String  @id
  invoiceId             String
  invoice               Invoice @relation(fields: [invoiceId], references: [id], onDelete: Restrict)
  lineNumber            Int
  instructionLineNumber Int?
  sku                   String?
  description           String
  quantityMilli         BigInt
  unitPriceCents        BigInt
  lineTotalCents        BigInt

  @@unique([invoiceId, lineNumber])
}

/// Every payment-provider event received (webhooks), deduplicated on (provider, eventId).
model ProviderEvent {
  id              String    @id
  provider        String
  eventId         String
  type            String
  idempotencyKey  String
  transactionId   String?
  organizationId  String?
  payloadHash     String
  /// applied | ignored_stale | ignored_terminal | unknown_transaction
  outcome         String
  detail          String?
  occurredAt      DateTime?
  receivedAt      DateTime  @default(now())

  @@unique([provider, eventId])
  @@index([idempotencyKey])
}

/// Results of independent account / ownership verification (provider-backed).
model SupplierVerification {
  id                String            @id
  organizationId    String
  supplierId        String
  supplierVersion   Int
  provider          String
  /// valid | invalid | unknown
  accountStatus     String
  /// match | partial | no_match | unavailable
  ownerNameMatch    String
  resultLevel       SupplierAssurance
  providerReference String?
  requestedByUserId String
  createdAt         DateTime          @default(now())

  @@index([supplierId])
}

/// Signed Merkle-root anchors of audit batches. The authoritative copy lives in
/// write-once storage OUTSIDE the database; this row is an index of it.
model AuditAnchor {
  id                 String   @id
  organizationId     String
  fromSequence       Int
  toSequence         Int
  eventCount         Int
  merkleRoot         String
  chainHeadHash      String
  previousMerkleRoot String?
  statement          Json
  signature          String
  keyId              String
  storageUri         String
  createdAt          DateTime @default(now())

  @@unique([organizationId, toSequence])
}
